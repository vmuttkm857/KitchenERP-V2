APP_ENV=development
APP_VERSION=0.1.0

# Required in every deployed environment. Production must inject this through
# the service environment or secret store; never commit a real credential.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/kitchenerp_v2
# Test-only database. Do not point this at development or production.
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/kitchenerp_v2_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
LOG_LEVEL=INFO
MEDIA_ROOT=./media

# Production must inject a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=kitchenerp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Development example only. Production must use the exact HTTPS frontend origin.
CORS_ORIGINS=["http://localhost:5173"]
