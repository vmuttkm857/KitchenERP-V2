APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/kitchenerp_v2
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/kitchenerp_v2_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=kitchenerp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]
